{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**/draftworx_data.json" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**/draftworx_data.json" }, { "path": "**/Draftworx-Backup-*.json" }, { "path": "**/Backups/Draftworx-Backup-*.json" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**/Backups" }]
    }
  ]
}
